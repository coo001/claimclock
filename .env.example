# Copy to .env (git-ignored) and fill in only on your own machine. Leave empty for key-free fixture mode.

# Tavily search key. Used by both recorded-run scripts; never sent to the browser.
TAVILY_API_KEY=

# Local Bifrost gateway. Must be localhost / 127.0.0.1. Used only by npm run live:run:bifrost.
BIFROST_BASE_URL=

# Bifrost virtual key for local live mode; keep only in ignored .env.
BIFROST_VIRTUAL_KEY=

# Gemini model name; used by both recorded-run scripts. Direct mode defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=

# Gemini key. Direct recorded-run script reads it from this ignored .env; browser/app server never receives it. Bifrost mode uses its local provider key.
GEMINI_API_KEY=

# App-side daily cap on live /api/verify runs (in-memory, resets per UTC day)
DAILY_VERIFY_LIMIT=20

# Optional tighter Tavily cap per live run (the app limit of 8 still applies)
LIVE_TAVILY_LIMIT=

PORT=5173
